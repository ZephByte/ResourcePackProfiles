{
  "schemaVersion": 1,
  "id": "resourcepackprofiles",
  "version": "${version}",
  "name": "Resource Pack Profiles",
  "description": "Save, manage, and share named resource pack load-order profiles. Switch between completely different pack setups in seconds, right from the resource pack screen.",
  "authors": [
    "ZephByte"
  ],
  "contact": {
    "homepage": "https://github.com/ZephByte/ResourcePackProfiles",
    "sources": "https://github.com/ZephByte/ResourcePackProfiles",
    "issues": "https://github.com/ZephByte/ResourcePackProfiles/issues"
  },
  "license": "MIT",
  "icon": "assets/resourcepackprofiles/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.zephbyte.resourcepackprofiles.client.ResourcepackprofilesClient"
    ],
    "modmenu": [
      "org.zephbyte.resourcepackprofiles.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "resourcepackprofiles.client.mixins.json",
      "environment": "client"
    }
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.2 <26.3"
  }
}
